<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.temporal.learn</groupId>
  <artifactId>temporal-learn</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>Temporal learn</name>
  <!--
    学习用反应器。字节码目标 Java 17，可用本机 JDK 21 编译和运行。
    contracts 放接口，三个 apps 分别是编排 Worker、模型 Worker 和启动客户端。
  -->

  <modules>
    <module>packages/contracts</module>
    <module>apps/workflow-worker</module>
    <module>apps/agent-worker</module>
    <module>apps/demo-client</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <temporal.version>1.32.1</temporal.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.temporal.learn</groupId>
        <artifactId>learn-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-sdk</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>2.0.16</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
